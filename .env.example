APP_ENV=development

APP_PORT=8080
DB_DSN=postgres://user:password@localhost:5432/portfolio?sslmode=disable

# Base URL frontend (tanpa trailing slash). Dipakai menyusun tautan di email,
# mis. tautan reset password: {APP_FRONTEND_URL}/auth/reset-password?token=...
APP_FRONTEND_URL=http://localhost:3000

# SEED (gunakan password yang kuat, jangan default)
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ganti-dengan-password-kuat

# Kalau mau auto buat sample tags+project:
SEED_SAMPLE_DATA=true

# JWT
# WAJIB diganti. Minimal 32 karakter. Generate dengan: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=3600 # detik, misal 1 jam

# CORS
# Jangan gunakan '*' jika CORS_ALLOW_CREDENTIALS=true.
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Origin, Content-Type, Accept, Authorization
CORS_ALLOW_CREDENTIALS=true

# COOKIE SESI (`access_token`)
# Default di bawah cocok untuk dev (FE :3000 + BE :8080 sama-sama di localhost)
# dan untuk deploy same-site. Untuk FE & BE di DOMAIN BERBEDA, lihat
# docs/DEPLOYMENT.md — ringkasnya: SameSite=None + Secure=true.
#
#   COOKIE_DOMAIN    kosong = host-only. Isi ".example.com" hanya bila FE dan BE
#                    berada di subdomain dari satu domain induk yang sama.
#   COOKIE_SAMESITE  Lax (default) | Strict | None
#   COOKIE_SECURE    default: true di produksi, false di luar produksi.
#                    WAJIB true bila COOKIE_SAMESITE=None.
COOKIE_DOMAIN=
COOKIE_SAMESITE=Lax
# COOKIE_SECURE=false

# SMTP (dipakai untuk email reset password)
# Bila SMTP_HOST/SMTP_FROM kosong: di luar produksi isi email hanya ditulis ke
# log (praktis saat dev), di produksi pengiriman DINONAKTIFKAN dan endpoint
# forgot-password membalas 503 — tautan reset tidak akan pernah masuk ke log.
# Port 465 memakai TLS implisit; port lain (mis. 587) memakai STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Portfolio

# Masa berlaku token reset password (detik). Default 3600 = 1 jam.
PASSWORD_RESET_TTL=3600

# UNGGAHAN BERKAS (gambar proyek & CV, disimpan ke disk server)
# APP_PUBLIC_URL adalah alamat backend ini DARI SISI BROWSER. Nilainya ikut
# tersimpan ke database sebagai bagian URL berkas, jadi di produksi wajib
# alamat asli — bukan localhost (ditolak saat startup).
APP_PUBLIC_URL=http://localhost:8080
UPLOAD_DIR=./uploads
UPLOAD_MAX_BYTES=5242880 # 5 MB per berkas
