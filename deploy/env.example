# Konfigurasi PRODUKSI — disalin install.sh menjadi deploy/.env (izin 600).
# Bukan berkas yang sama dengan .env.example di akar repo (itu untuk `make run`
# di laptop). Penjelasan panjang tiap kunci aplikasi ada di sana dan di
# docs/DEPLOYMENT.md; di sini hanya yang perlu diputuskan saat memasang.
#
# Nilai berkarakter khusus ($, #, spasi) ditulis dalam kutip tunggal. Jangan
# menulis kunci yang sama dua kali: yang dipakai baris terakhir.

# ------------------------------------------------------------- alamat publik
# Alamat backend ini DARI SISI BROWSER (ikut tersimpan di URL berkas unggahan).
# Wajib alamat asli; "localhost" ditolak saat start.
APP_PUBLIC_URL=<https://api.contoh.id>
# Alamat frontend (tautan di email reset password) dan origin yang diizinkan CORS.
APP_FRONTEND_URL=<https://contoh.id>
CORS_ALLOWED_ORIGINS=<https://contoh.id>
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS='Origin, Content-Type, Accept, Authorization'
CORS_ALLOW_CREDENTIALS=true

# ------------------------------------------------------------- port & jaringan
# Alamat tempat port API diikat di server ini. Port yang dipublikasikan Docker
# MELEWATI UFW/CSF, jadi nilai ini adalah keputusan keamanan:
#   127.0.0.1  hanya dari server ini — untuk reverse proxy di host yang sama (bawaan)
#   0.0.0.0    terbuka ke semua antarmuka, termasuk internet
ALAMAT_IKAT=127.0.0.1
PORT_API=8080
# Dipilih otomatis oleh install.sh; isi manual hanya bila ia tidak menemukan
# rentang yang bebas.
DOCKER_SUBNET=
DOCKER_SUBNET_DALAM=
# Ikut ditulis fungsi bersama tetapi TIDAK dipakai stack ini (tidak ada reverse
# proxy di dalamnya). Jangan disalin ke TRUSTED_PROXIES.
PROXY_IP=
# API yang terbuka ke internet lewat HTTP polos mengirim password dan token
# admin tanpa enkripsi. install.sh menolak ALAMAT_IKAT=0.0.0.0 dengan
# APP_PUBLIC_URL non-https kecuali ini diisi "ya" (keputusan sadar, sementara).
IZINKAN_HTTP_TERBUKA=

# ------------------------------------------------------------- database
# "db" = PostgreSQL ikut dijalankan di server ini. Kosongkan bila DB_DSN
# menunjuk database di tempat lain: backup.sh lalu HANYA mencadangkan berkas
# unggahan, dan cadangan database menjadi urusan server database itu.
COMPOSE_PROFILES=db
POSTGRES_USER=portfolio
POSTGRES_DB=portfolio
# Dibuat install.sh. Hanya huruf dan angka (ikut dipakai di dalam DB_DSN).
POSTGRES_PASSWORD=
# Disusun install.sh dari tiga nilai di atas bila profil "db" aktif.
DB_DSN=

# ------------------------------------------------------------- rahasia & sesi
# Dibuat install.sh sekali dan tidak pernah ditimpa (menimpa = semua sesi putus).
JWT_SECRET=
JWT_EXPIRES_IN=3600
COOKIE_DOMAIN=
COOKIE_SAMESITE=Lax

# ------------------------------------------------------------- admin pertama
# Dipakai install.sh SEKALI, saat pemasangan pertama. Password-nya dibuat acak,
# tidak disimpan di berkas ini, dan ditulis ke /root/portfolio-backend-admin-awal.txt.
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=<admin@contoh.id>

# ------------------------------------------------------------- email (reset password)
# Kosong = fitur reset password dinonaktifkan (endpoint-nya membalas 503).
# Reset lewat email adalah SATU-SATUNYA cara mengganti password admin.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Portfolio
PASSWORD_RESET_TTL=3600

# ------------------------------------------------------------- unggahan
UPLOAD_MAX_BYTES=5242880

# ------------------------------------------------------------- reverse proxy
# Kosong selama belum ada reverse proxy di depan. Setelah ada, isi IP proxy
# sebagaimana dilihat backend — lihat docs/DEPLOYMENT.md.
TRUSTED_PROXIES=

# ------------------------------------------------------------- image
# github = tarik image yang dibangun GitHub Actions untuk commit yang ter-checkout
#          (bawaan; server tidak perlu membangun);
# lokal  = bangun di server ini. Untuk sekali jalan: --bangun-lokal.
SUMBER_IMAGE=github
# Kosong = ghcr.io/fauzanparanditha/go-portfolio-backend
IMAGE_JAUH=

# ------------------------------------------------------------- operasional
API_MEM_LIMIT=256m
DB_MEM_LIMIT=512m
BACKUP_DIR=/var/backups/portfolio-backend
BACKUP_KEEP_DAYS=14
# Alarm hasil update/backup (opsional). Butuh jq dan curl.
ALARM_WEBHOOK_URL=
ALARM_TELEGRAM_BOT_TOKEN=
ALARM_TELEGRAM_CHAT_ID=
